# FORT Learning - Environment Configuration
# Copy this file to .env.local for local development.

# ==============================================================================
# SITE & APPLICATION
# ==============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="FORT Learning"
NEXT_PUBLIC_APP_TAGLINE="Knowledge. Built Strong."

# ==============================================================================
# SUPABASE (Database, Auth, Storage)
# ==============================================================================
# Public anonymous key for client-side operations (RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key for privileged server-side operations (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# PAYMENTS (Razorpay)
# ==============================================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ==============================================================================
# EMAIL (Resend)
# ==============================================================================
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="FORT Learning <support@fortlearning.com>"

# ==============================================================================
# OAUTH PROVIDERS
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==============================================================================
# MONITORING & ERROR REPORTING
# ==============================================================================
SENTRY_DSN=
